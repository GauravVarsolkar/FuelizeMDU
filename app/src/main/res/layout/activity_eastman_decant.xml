<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="ContentDescription,HardcodedText,UselessParent,DisableBaselineAlignment,RtlHardcoded"
    tools:context=".EastmanDecantActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/app_footer"
        android:layout_alignParentTop="true"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp">

            <ImageView
                android:id= "@+id/img_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="10dp"
                android:src="@drawable/back_arrow" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:gravity="center_vertical"
                android:text="MDU App for N777A RS485         Version 2.12  /  03-Mar-2026 - Tokheim DU"
                android:textColor="@color/blue"
                android:textSize="@dimen/twenty" />



        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/five">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:background="@color/white"
                android:orientation="horizontal">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:orientation="vertical"
                        android:paddingBottom="@dimen/default_text_size">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp"
                                android:layout_weight="0.6"
                                android:text="RFID Tag :"
                                android:textColor="@color/textColor"
                                android:textSize="@dimen/sixteen"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_tag_id"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.4"
                                android:hint="Tag Status"
                                android:textColor="@color/dark_orange"
                                android:textSize="@dimen/sixteen" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/grey" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp"
                                android:layout_weight="0.6"
                                android:text="Order No :"
                                android:textColor="@color/textColor"
                                android:textSize="@dimen/sixteen"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_crm_number"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.4"
                                android:singleLine="true"
                                android:textColor="@color/textColor"
                                android:textSize="@dimen/sixteen" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/grey" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp"
                                android:layout_weight="0.6"
                                android:text="Ordered Quantity :"
                                android:textColor="@color/textColor"
                                android:textSize="@dimen/sixteen"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_order_quantity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.4"
                                android:singleLine="true"
                                android:textColor="@color/textColor"
                                android:textSize="@dimen/sixteen" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/grey" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp"
                                android:layout_weight="0.6"
                                android:text="DU Status :"
                                android:textColor="@color/textColor"
                                android:textSize="@dimen/sixteen"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_du_conn_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.4"
                                android:textColor="@color/textColor"
                                android:textSize="@dimen/sixteen" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/grey"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp"
                                android:layout_weight="0.6"
                                android:text="RFID Status :"
                                android:textColor="@color/textColor"
                                android:textSize="@dimen/sixteen"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_rfid_conn_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.4"
                                android:textColor="@color/textColor"
                                android:textSize="@dimen/sixteen" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/grey"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp"
                                android:layout_weight="0.6"
                                android:text="Dispensed Quantity :"
                                android:textColor="@color/textColor"
                                android:textSize="@dimen/sixteen"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_mdu_filling_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.4"
                                android:textColor="@color/textColor"
                                android:textSize="@dimen/sixteen" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/grey"/>


                        <!--                        <LinearLayout-->
                        <!--                            android:layout_width="match_parent"-->
                        <!--                            android:layout_height="wrap_content"-->
                        <!--                            android:layout_margin="5dp"-->
                        <!--                            android:orientation="horizontal">-->

                        <!--                            <TextView-->
                        <!--                                android:layout_width="match_parent"-->
                        <!--                                android:layout_height="wrap_content"-->
                        <!--                                android:layout_marginLeft="10dp"-->
                        <!--                                android:layout_weight="0.6"-->
                        <!--                                android:text="Delivered Quantity :"-->
                        <!--                                android:textColor="@color/textColor"-->
                        <!--                                android:textSize="@dimen/sixteen"-->
                        <!--                                android:textStyle="bold" />-->

                        <!--                            <TextView-->
                        <!--                                android:id="@+id/tv_mdu_filling_status"-->
                        <!--                                android:layout_width="match_parent"-->
                        <!--                                android:layout_height="wrap_content"-->
                        <!--                                android:layout_weight="0.4"-->
                        <!--                                android:gravity="center"-->
                        <!--                                android:textColor="@color/dark_orange"-->
                        <!--                                android:textSize="@dimen/sixteen" />-->

                        <!--                        </LinearLayout>-->


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="10dp"
                                android:text="Please Note : Do not Refresh or close this page."
                                android:textColor="@color/dark_orange"
                                android:textSize="@dimen/sixteen"
                                android:textStyle="bold"
                                android:layout_weight="0.2"
                                />
                            <Button
                                android:id="@+id/btn_resume"
                                android:layout_width="wrap_content"
                                android:layout_height="fill_parent"
                                android:layout_gravity="center"
                                android:layout_margin="5dp"
                                android:background="@color/colorPrimary"
                                android:gravity="center"
                                android:paddingLeft="15dp"
                                android:paddingEnd="15dp"
                                android:text="RESUME"
                                android:textColor="@color/white"
                                android:textSize="@dimen/eighteen"
                                android:visibility="invisible" />

                            <Button
                                android:id="@+id/btn_start_delivery"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_margin="5dp"
                                android:background="@drawable/buttons_border"
                                android:text="Start Delivery"
                                android:paddingLeft="15dp"
                                android:paddingEnd="15dp"
                                android:textAllCaps="false"
                                android:textColor="@color/white" />

                            <Button
                                android:id="@+id/btn_finish_order"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_margin="5dp"
                                android:background="@drawable/buttons_border"
                                android:paddingLeft="15dp"
                                android:paddingEnd="15dp"
                                android:text="Print Receipt"
                                android:textAllCaps="false"
                                android:textColor="@color/white" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvLogs"
                            android:layout_width="683dp"
                            android:layout_height="68dp"
                            android:scrollbars = "vertical"
                            android:text="TextView" />

                    </LinearLayout>

                </ScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/img_nozzle_state"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="center_vertical"
                        android:scaleType="fitXY"
                        android:visibility="invisible" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Process Logs"
                        android:textColor="@color/black"
                        android:textSize="@dimen/header_text"
                        android:textStyle="bold" />

                    <ScrollView
                        android:id="@+id/scrollView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fillViewport="true"
                        android:padding="5dp">

                        <TextView
                            android:id="@+id/tv_output"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/cell_shape_all_bg"
                            android:hint="logs...."
                            android:padding="10dp"
                            android:scrollbars="vertical"
                            android:textColor="@color/black"
                            android:textSize="@dimen/ten" />
                    </ScrollView>
                </LinearLayout>
            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

